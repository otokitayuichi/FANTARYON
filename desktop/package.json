{
  "name": "fantaryon-desktop",
  "productName": "FANTARYON",
  "version": "1.0.0",
  "description": "FANTARYON - ROMEOTTO（Windows版：Electronでpublic/をアプリ化）",
  "author": "ROMEOTTO",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "net.otkt.fantaryon",
    "productName": "FANTARYON",
    "copyright": "© ROMEOTTO",
    "files": ["main.js", "build/icon.png", "app/**/*"],
    "directories": { "output": "dist" },
    "win": { "target": "portable", "icon": "build/icon.ico" },
    "portable": { "artifactName": "fantaryon.exe" }
  }
}
