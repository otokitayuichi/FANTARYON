{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FANTARYON",
  "version": "../package.json",
  "identifier": "net.otkt.fantaryon",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FANTARYON",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 270,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"]
  }
}
